{
  "name": "hawrisha-bazaar",
  "version": "1.0.0",
  "private": true,
  "description": "Hawrisha Bazaar Monorepo — Customer Website, Admin/Store Dashboard, and Backend API",
  "workspaces": [
    "website",
    "dashboard",
    "backend"
  ],
  "scripts": {
    "dev:website": "npm run dev --prefix website",
    "dev:dashboard": "npm run dev --prefix dashboard",
    "dev:backend": "npm run start --prefix backend",
    "dev": "npm run dev:website",
    "build:website": "npm run build --prefix website",
    "build:dashboard": "npm run build --prefix dashboard"
  }
}
